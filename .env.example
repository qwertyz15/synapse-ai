# API keys for different providers
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
USE_AWS_BEDROCK=false

#Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=

# Amazon Bedrock Knowledge Base ID
AWS_KB_ID="<knowledge-base-id>"

# Use a fake model for testing
USE_FAKE_MODEL=false

# Set a default model
DEFAULT_MODEL=

# If MODEL is set to "openai-compatible", set the following
# This is just a flexible solution. If you need multiple model options, you still need to add it to models.py
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

# Web server configuration. Keep 127.0.0.1 unless other machines must reach the service
# directly (Docker sets 0.0.0.0 itself).
HOST=127.0.0.1
PORT=8080

# Bearer token for the agent service API, also used by the web UI to call it.
# Required whenever HOST isn't a localhost address (including Docker); the service refuses to
# start without it. Generate one with: openssl rand -hex 32
AUTH_SECRET=

# Name each new chat with a few words from its model, like ChatGPT (one short extra call per chat).
# Set to false to keep the first message as the title.
# GENERATE_CHAT_TITLES=true

# Web UI usage limits (0 turns a limit off). Each IP gets 3x the per-user limits. Per-IP limits
# need a reverse proxy that sets X-Forwarded-For; the global chat limit applies either way.
# RATE_LIMIT_CHATS_PER_HOUR=60
# RATE_LIMIT_CHATS_PER_MINUTE_GLOBAL=120
# RATE_LIMIT_UPLOADS_PER_HOUR=20

# Langsmith configuration
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=default
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Application mode. If the value is "dev", it will enable uvicorn reload
MODE=

# Database type.
# If the value is "postgres", then it will require Postgresql related environment variables.
# If the value is "sqlite", then you can configure optional file path via SQLITE_DB_PATH
DATABASE_TYPE=

# If DATABASE_TYPE=sqlite (Optional)
SQLITE_DB_PATH=

# App database for chats, attachments and the library index (SQLAlchemy URL). Defaults to
# sqlite:///app.db, or to the POSTGRES_* database when DATABASE_TYPE=postgres.
# APP_DATABASE_URL=sqlite:///app.db

# If DATABASE_TYPE=postgres
# Docker Compose requires POSTGRES_PASSWORD (generate one with: openssl rand -hex 24).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

# you will be able to identify AST connections in Postgres Connection Manager under this Application Name
# POSTGRES_APPLICATION_NAME = "agent-service-toolkit"
# set these values to customize the number of connections in the pool. Saver and store have independent connection pools
# POSTGRES_MIN_CONNECTIONS_PER_POOL=1
# POSTGRES_MAX_CONNECTIONS_PER_POOL= 3

# If DATABASE_TYPE=mongo
# See docker/compose.mongo.yaml for a local Mongo container to test against
MONGO_HOST=
MONGO_PORT=
MONGO_DB=
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_AUTH_SOURCE=
# MONGO_TLS=false

# OpenWeatherMap API key
OPENWEATHERMAP_API_KEY=

# Embeddings for the RAG assistant: "openai" (default, uses OPENAI_API_KEY) or "voyage"
# Rebuild the Chroma database (scripts/create_chroma_db.py) after changing provider or model.
EMBEDDING_PROVIDER=
# Optional. Defaults: text-embedding-ada-002 (openai), voyage-4 (voyage)
EMBEDDING_MODEL=
VOYAGE_API_KEY=

# RAG ingestion (scripts/ingest.py). Defaults shown.
# RAG_DATA_DIR=./data
# CHROMA_DB_PATH=./chroma_db
# RAG_CHUNK_SIZE=2000
# RAG_CHUNK_OVERLAP=500

# Add for running ollama
# OLLAMA_MODEL=llama3.2
# Note: set OLLAMA_BASE_URL if running service in docker and ollama on bare metal
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Add for running Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT_MAP={"gpt-5": "gpt-5-deployment", "gpt-5-mini": "gpt-5-mini-deployment"}

# Agent URL: used in Streamlit app - if not set, defaults to http://{HOST}:{PORT}
# AGENT_URL=http://localhost:8080

# LANGFUSE Configuration
#LANGFUSE_TRACING=true
#LANGFUSE_PUBLIC_KEY=pk-...
#LANGFUSE_SECRET_KEY=sk-lf-....
#LANGFUSE_HOST=http://localhost:3000

# GitHub MCP Agent Configuration
# "Connect GitHub" in the web UI: each user links their own account through a GitHub App.
# See docs/GitHub_MCP_Agent.md for creating the app (callback: http://localhost:3000/api/github/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's URL name (github.com/apps/<slug>); lets Connect open the "choose repositories" step
GITHUB_APP_SLUG=
# Encrypts the GitHub connection cookie; generate with: openssl rand -base64 32
WEB_SESSION_SECRET=
# Optional service-wide fallback token for API/Streamlit use (a personal access token)
GITHUB_PAT=

# Voice Features (Optional)
# NOTE: Voice features are configured on the client (Streamlit app) side, not the server (API).
# Requires OPENAI_API_KEY to be set (see above).
# Set provider name to enable voice input/output. Leave empty to disable.
VOICE_STT_PROVIDER=        # Speech-to-text provider (only 'openai' supported currently)
VOICE_TTS_PROVIDER=        # Text-to-speech provider (only 'openai' supported currently)

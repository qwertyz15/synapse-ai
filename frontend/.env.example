# URL of the FastAPI agent service (server-side only; the browser talks to /api/agent).
AGENT_URL=http://localhost:8080

# Must match AUTH_SECRET in the service's .env, if it's set there.
# AUTH_SECRET=

# "Connect GitHub" (GitHub App OAuth); run.sh passes these from the root .env.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# WEB_SESSION_SECRET=
# Override when the app isn't served from the origin the browser uses, e.g. behind a proxy.
# GITHUB_REDIRECT_URI=http://localhost:3000/api/github/callback
